# SPDX-License-Identifier: Apache-2.0
#
# 阿里云百炼（DashScope）配置样例 —— 仅为占位符，不含任何真实密钥。
# 用法：把下面 12 个字段合并进仓库根目录的 .env（.env 已被 git 忽略）。
#
# 四个 triplet 必须全部写全。model_config.py::resolve() 在各字段缺失时会
# 回落到 DEFAULT_MODELS_*（NVIDIA），导致推理与检索走不同厂商。
# EMBED 换模型后必须重建向量库，详见 customization/README.md 第 3 节。
#
# 注意：推理/embedding 与 rerank 的 base path 不同。
#   chat + embeddings : /compatible-mode/v1
#   rerank            : /compatible-api/v1/reranks   （复数）

# --- 推理：Qwen3.8-Flash，支持 json_schema strict 结构化输出 ---
REASONING_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
REASONING_API_KEY=sk-<YOUR_DASHSCOPE_API_KEY>
REASONING_MODEL=qwen3.8-flash

NON_REASONING_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
NON_REASONING_API_KEY=sk-<YOUR_DASHSCOPE_API_KEY>
NON_REASONING_MODEL=qwen3.8-flash

# --- 向量：必须 2048 维，代码通过 __post_init__ 自动传 dimensions ---
EMBED_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=sk-<YOUR_DASHSCOPE_API_KEY>
EMBED_MODEL=text-embedding-v4

# --- 重排：结果为 results[].relevance_score ---
RERANK_ENDPOINT=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
RERANK_API_KEY=sk-<YOUR_DASHSCOPE_API_KEY>
RERANK_MODEL=qwen3-rerank

# --- 可选：并发（百炼 RPM 15000，可适当上调）---
# SEMANTIC_LLM_MAX_INFLIGHT=12
# LLM_MAX_INFLIGHT=12

# --- 回退用：恢复 NVIDIA 时改回以下值，并重建向量库 ---
# REASONING_ENDPOINT=https://integrate.api.nvidia.com/v1
# REASONING_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
# RERANK_ENDPOINT=https://ai.api.nvidia.com/v1/retrieval/nvidia/nemotron-3.5-rerank-8b/reranking
# RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b
